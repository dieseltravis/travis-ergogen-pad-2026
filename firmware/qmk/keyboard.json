{
    "version": 1,
    "maintainer": "dieseltravis",
    "manufacturer": "dieseltravis",
    "author": "Travis Hardiman",
    "keyboard_name": "travipad2026",
    "keyboard": "dieseltravis/travipad2026",
    "keymap": "dieseltravis_travipad2026_layout_base_default",
    "url": "https://github.com/dieseltravis/travis-ergogen-pad-2026",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "debounce": 10,
    "diode_direction": "COL2ROW",
    "build": {
        "firmware_format": "uf2"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "oled": false,
        "nkro": true,
        "rgblight": false
    },
    "usb": {
        "device_version": "1.0.1",
        "pid": "0x202A",
        "vid": "0x1979"
    },
    "matrix_pins": {
        "cols": ["GP6", "GP7", "GP0"],
        "rows": ["GP26", "GP27", "GP28", "GP29"]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [2, 0], "label":"Del",     "x": 0, "y": 3},
                {"matrix": [2, 1], "label":"ScrLock", "x": 1, "y": 3},
                {"matrix": [2, 2], "label":"Break",   "x": 2, "y": 3},
                {"matrix": [2, 3], "label":"Ins",     "x": 3, "y": 3},
                {"matrix": [1, 0], "label":"Home",    "x": 0, "y": 4},
                {"matrix": [1, 1], "label":"PgDown",  "x": 1, "y": 4},
                {"matrix": [1, 2], "label":"End",     "x": 2, "y": 4},
                {"matrix": [1, 3], "label":"PgUp",    "x": 3, "y": 4},
                {"matrix": [0, 0], "label":"Left",    "x": 0, "y": 5},
                {"matrix": [0, 1], "label":"Down",    "x": 1, "y": 5},
                {"matrix": [0, 2], "label":"Right",   "x": 2, "y": 5},
                {"matrix": [0, 3], "label":"Up",      "x": 3, "y": 5}
            ]
        }
    }
}
